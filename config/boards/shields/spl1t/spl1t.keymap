#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";

            // ---------------------------------------------------------------------------------------------------------
            // | ESC     | Q       | W       | E       | R       | T       |                | Y       | U       | I       | O       | P       | BSPC    |
            // | TAB     | A       | S       | D       | F       | G       |                | H       | J       | K       | L       | ;       | '       |
            // | LSHIFT  | Z       | X       | C       | V       | B       |                | N       | M       | ,       | .       | /       | DEL     |
            //                               | OPT     | LWR     | CMD     | SPC    | RET   | CMD     | RSE     | RCTRL   |
            bindings = <
                &kp ESC     &kp Q       &kp W       &kp E       &kp R       &kp T             &kp Y       &kp U       &kp I       &kp O       &kp P       &kp BSPC
                &kp TAB     &kp A       &kp S       &kp D       &kp F       &kp G             &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp SQT
                &kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B             &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp DEL
                                                &kp LALT   &mo 1    &kp LGUI    &kp SPACE &kp RET  &kp RGUI     &mo 2       &kp RCTRL
            >;
        };

        lower_layer {
            display-name = "lower";

            // ---------------------------------------------------------------------------------------------------------
            // | TAB     | 1       | 2       | 3       | 4       | 5       |     | 6       | 7       | 8       | 9       | 0       | BSPC    |
            // | BT_CLR  | BT_0    | BT_1    | BT_2    | BT_3    | BT_4    |     | LEFT    | DOWN    | UP      | RIGHT   |         | F12     |
            // | LSHIFT  | F1      | F2      | F3      | F4      | F5      |     | F6      | F7      | F8      | F9      | F10     | F11     |
            //                               | BOOT    |         |         |     |         |         |         |         |
            bindings = <
                &kp TAB     &kp N1      &kp N2      &kp N3      &kp N4      &kp N5            &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp BSPC
                &bt BT_CLR  &trans      &trans      &trans      &trans      &trans            &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &trans      &kp F12
                &kp LSHFT   &kp F1      &kp F2      &kp F3      &kp F4      &kp F5            &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp F11
                                                &bootloader &trans      &trans      &trans            &trans      &trans      &trans      &trans
            >;
        };

        raise_layer {
            display-name = "raise";

            // ---------------------------------------------------------------------------------------------------------
            // | TAB     | !       | @       | #       | $       | %       |     | ^       | &       | *       | (       | )       | BSPC    |
            // | LCTRL   |         |         |         |         |         |     | -       | =       | [       | ]       | \       | `       |
            // | LSHIFT  |         |         |         |         |         |     | _       | +       | {       | }       | |       | ~       |
            //                               |         |         |         |     |         |         |         | BOOT    |
            bindings = <
                &kp TAB     &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT         &kp CARET   &kp AMPS    &kp KP_MULTIPLY &kp LPAR    &kp RPAR    &kp BSPC
                &kp LCTRL   &trans      &trans      &trans      &trans      &trans            &kp MINUS   &kp EQUAL   &kp LBKT        &kp RBKT    &kp BSLH    &kp GRAVE
                &kp LSHFT   &trans      &trans      &trans      &trans      &trans            &kp UNDER   &kp PLUS    &kp LBRC        &kp RBRC    &kp PIPE    &kp TILDE
                                                &trans      &trans      &trans      &trans            &trans      &trans      &trans      &bootloader
            >;
        };
    };
};
